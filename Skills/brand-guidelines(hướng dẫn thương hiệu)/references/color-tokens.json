{
  "brand": "Antigravity",
  "version": "1.0.0",
  "standard": "Elite 2026",
  "tokens": {
    "colors": {
      "primitive": {
        "black": "#0D0D12",
        "white": "#FFFFFF",
        "blue-600": "#3B82F6",
        "green-500": "#10B981",
        "gold-500": "#F59E0B",
        "gray-400": "#9CA3AF"
      },
      "semantic": {
        "background": "{colors.primitive.black}",
        "foreground": "{colors.primitive.white}",
        "primary": "{colors.primitive.blue-600}",
        "success": "{colors.primitive.green-500}",
        "warning": "{colors.primitive.gold-500}",
        "border": "{colors.primitive.gray-400}"
      }
    },
    "typography": {
      "fontFamilies": {
        "heading": "Outfit, sans-serif",
        "body": "Inter, sans-serif",
        "mono": "JetBrains Mono, monospace"
      },
      "fontWeights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      }
    },
    "motion": {
      "durations": {
        "fast": "150ms",
        "standard": "300ms",
        "slow": "500ms"
      },
      "easings": {
        "default": "cubic-bezier(0.4, 0, 0.2, 1)",
        "in": "cubic-bezier(0.4, 0, 1, 1)",
        "out": "cubic-bezier(0, 0, 0.2, 1)"
      }
    }
  }
}
